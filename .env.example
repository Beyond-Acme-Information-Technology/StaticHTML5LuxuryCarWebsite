# Copy to .env.local for local testing. Never commit real values.
# On Vercel: Project Settings → Environment Variables

CONTACT_TO_EMAIL=awesomeluxuryservices@gmail.com

# Must be a sender verified in Brevo (Senders, domains, and IPs)
FROM_EMAIL=awesomeluxuryservices@gmail.com

# Brevo SMTP (Settings → SMTP & API → SMTP)
BREVO_SMTP_HOST=smtp-relay.brevo.com
BREVO_SMTP_PORT=587
BREVO_SMTP_USER=a2a92f001@smtp-brevo.com
BREVO_SMTP_KEY=

REQUIRE_EMAIL_PROVIDER=true

# Staff inbox (Login → Staff). Use a long random string.
STAFF_INBOX_TOKEN=

# Optional SendGrid fallback
SENDGRID_API_KEY=

# Persist leads and client-portal codes (run supabase/schema.sql first)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
